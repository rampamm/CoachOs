# ---- LINE Messaging API ----
# From LINE Developers console > your Messaging API channel
LINE_CHANNEL_SECRET=your_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_long_lived_channel_access_token_here

# ---- LLM (DeepSeek) ----
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- Google Sheets ----
# Path to the service-account JSON key file you downloaded from Google Cloud.
# Keep it OUTSIDE this repo folder (e.g. ~/.config/coachos/service_account.json)
# so it can never be accidentally committed.
GOOGLE_SERVICE_ACCOUNT_FILE=/Users/you/.config/coachos/service_account.json
# The spreadsheet ID (the long string in the sheet URL between /d/ and /edit)
GOOGLE_SHEET_ID=your_sheet_id_here
# The tab (worksheet) name inside that spreadsheet
GOOGLE_WORKSHEET_NAME=workouts
